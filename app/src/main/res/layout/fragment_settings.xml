<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cookie_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="17sp"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_relogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="扫码重新登录" />

            <Button
                android:id="@+id/button_change_folder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="更改音乐文件夹" />

            <Button
                android:id="@+id/button_logout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="登出" />
        </LinearLayout>

        <!-- 诊断区：帮助排查"页面空白/加载失败"类问题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="诊断"
            android:textSize="22sp"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/diag_cookie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="15sp"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_test_api"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="测试列表接口" />

            <Button
                android:id="@+id/button_clear_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="清空日志" />
        </LinearLayout>

        <TextView
            android:id="@+id/diag_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#22000000"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:id="@+id/debug_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="调试：粘贴浏览器 Cookie（从已登录的 115 网页版复制整串 Cookie）"
                android:textSize="16sp"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/cookie_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="UID=...; CID=...; SEID=...; ..."
                android:textSize="14sp"
                android:inputType="textMultiLine"
                android:minLines="2" />

            <Button
                android:id="@+id/button_save_cookie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="保存 Cookie" />
        </LinearLayout>

        <TextView
            android:id="@+id/about_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</ScrollView>
